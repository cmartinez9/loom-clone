{
  "name": "loom-clone",
  "private": true,
  "version": "0.1.0",
  "description": "Local-only macOS screen recorder and editor",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/install-electron-runtime.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:mutation": "node scripts/mutation-check.mjs",
    "verify:permissions": "node scripts/verify-permissions.mjs",
    "record:cursor-corpus": "node scripts/record-cursor-corpus.mjs",
    "package": "npm run build && electron-builder --mac --config electron-builder.yml",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "electron": "43.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "yaml": "^2.7.0"
  }
}
